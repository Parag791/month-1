@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700&display=swap');

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: "DM Sans", sans-serif;
    background: #f7f5ee;
    color: #17362f;
    line-height: 1.6;
}

a {
    text-decoration: none;
    color: inherit;
}


/* NAVBAR */

header {
    height: 75px;
    background: white;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 7%;
    position: sticky;
    top: 0;
    z-index: 10;
    border-bottom: 1px solid #e8ece8;
}

.logo {
    font-size: 25px;
    font-weight: 700;
    color: #123c32;
}

.logo span {
    color: #1c7658;
}

nav {
    display: flex;
    gap: 28px;
}

nav a {
    font-size: 14px;
    font-weight: 600;
    color: #52635d;
}

nav a:hover {
    color: #1c7658;
}

.nav-btn {
    background: #123c32;
    color: white;
    padding: 11px 22px;
    border-radius: 30px;
    font-weight: 600;
}


/* HERO */

.hero {
    min-height: 650px;
    padding: 70px 7%;
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 50px;
    background: linear-gradient(135deg, #f7f5ee, #e4f0df);
}

.tag {
    font-size: 12px;
    letter-spacing: 2px;
    font-weight: 700;
    color: #1c7658;
}

.hero h1 {
    font-family: "Playfair Display", serif;
    font-size: 75px;
    line-height: 1.05;
    margin: 18px 0;
}

.hero h1 span,
h2 span {
    color: #1c7658;
}

.hero-content > p:not(.tag) {
    max-width: 620px;
    color: #66756f;
    font-size: 17px;
    margin-bottom: 28px;
}

.buttons {
    display: flex;
    gap: 12px;
}

.btn {
    display: inline-block;
    background: #123c32;
    color: white;
    padding: 13px 24px;
    border-radius: 30px;
    font-weight: 700;
    font-size: 14px;
}

.btn.outline {
    background: transparent;
    border: 1px solid #87978f;
    color: #123c32;
}

.hero-box {
    height: 430px;
    background: #123c32;
    border-radius: 35px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    color: white;
    text-align: center;
}

.heart {
    font-size: 70px;
    color: #c8e86b;
    margin-bottom: 10px;
}

.hero-box h2 {
    font-family: "Playfair Display", serif;
    font-size: 32px;
}

.hero-box p {
    color: #c8d5d0;
}


/* ABOUT */

.about {
    background: white;
    padding: 100px 7%;
}

.about-content {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 70px;
    margin-top: 15px;
}

.about h2,
.projects h2,
.purpose h2,
.cta h2 {
    font-family: "Playfair Display", serif;
    font-size: 50px;
    line-height: 1.15;
}

.about-content p {
    color: #66756f;
    margin-bottom: 17px;
}


/* PROJECTS */

.projects {
    padding: 100px 7%;
}

.projects > h2 {
    margin: 12px 0 45px;
}

.project-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: white;
    padding: 28px;
    border-radius: 20px;
    border: 1px solid #dce3dc;
    min-height: 260px;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-7px);
    box-shadow: 0 15px 35px rgba(18, 60, 50, 0.12);
}

.icon {
    font-size: 38px;
    margin-bottom: 15px;
}

.card small {
    float: right;
    color: #a2aea8;
    font-weight: 700;
}

.card h3 {
    font-family: "Playfair Display", serif;
    font-size: 26px;
    margin-bottom: 8px;
}

.card p {
    color: #66756f;
    font-size: 14px;
}


/* IMPACT */

.impact {
    padding: 90px 7%;
    background: #123c32;
    color: white;
    text-align: center;
}

.impact .tag {
    color: #c8e86b;
}

.impact h2 {
    font-family: "Playfair Display", serif;
    font-size: 50px;
    margin: 12px 0 45px;
}

.stats {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    border-top: 1px solid rgba(255,255,255,0.2);
    border-bottom: 1px solid rgba(255,255,255,0.2);
}

.stats div {
    padding: 28px 10px;
    border-right: 1px solid rgba(255,255,255,0.2);
}

.stats div:last-child {
    border-right: none;
}

.stats strong {
    display: block;
    font-family: "Playfair Display", serif;
    font-size: 36px;
    color: #c8e86b;
}

.stats p {
    color: #d5e0da;
}


/* PURPOSE */

.purpose {
    background: white;
    padding: 100px 7%;
    text-align: center;
}

.purpose h2 {
    max-width: 850px;
    margin: 15px auto 20px;
}

.purpose > p:last-child {
    max-width: 750px;
    margin: auto;
    color: #66756f;
}


/* CTA */

.cta {
    background: #c8e86b;
    padding: 70px 7%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.cta h2 {
    margin: 8px 0;
}

.cta p:not(.tag) {
    color: #365047;
}

.white {
    background: #123c32;
    white-space: nowrap;
}


/* FOOTER */

footer {
    background: #0b2923;
    color: #c9d5d0;
    padding: 55px 7% 20px;
}

.footer-content {
    display: grid;
    grid-template-columns: 2fr 1fr 1fr;
    gap: 50px;
    padding-bottom: 40px;
}

.footer-logo {
    color: white;
}

.footer-content h3 {
    color: #c8e86b;
    font-size: 12px;
    letter-spacing: 2px;
    margin-bottom: 12px;
}

.footer-content a {
    display: block;
    margin-bottom: 7px;
    font-size: 14px;
}

.footer-content p {
    color: #aebdb7;
    font-size: 14px;
    margin-bottom: 8px;
}

.copyright {
    border-top: 1px solid rgba(255,255,255,0.15);
    padding-top: 20px;
    font-size: 12px;
    color: #83968e;
}


/* RESPONSIVE */

@media(max-width: 850px) {

    nav {
        display: none;
    }

    .hero {
        grid-template-columns: 1fr;
    }

    .hero h1 {
        font-size: 55px;
    }

    .about-content {
        grid-template-columns: 1fr;
        gap: 25px;
    }

    .project-container {
        grid-template-columns: 1fr 1fr;
    }

    .stats {
        grid-template-columns: repeat(2, 1fr);
    }

    .stats div {
        border-bottom: 1px solid rgba(255,255,255,0.2);
    }

    .footer-content {
        grid-template-columns: 1fr 1fr;
    }
}


@media(max-width: 550px) {

    .nav-btn {
        display: none;
    }

    .hero,
    .about,
    .projects,
    .impact,
    .purpose,
    .cta,
    footer {
        padding-left: 5%;
        padding-right: 5%;
    }

    .hero h1 {
        font-size: 45px;
    }

    .project-container {
        grid-template-columns: 1fr;
    }

    .stats {
        grid-template-columns: 1fr;
    }

    .stats div {
        border-right: none;
    }

    .cta {
        flex-direction: column;
        align-items: flex-start;
    }

    .footer-content {
        grid-template-columns: 1fr;
    }
}